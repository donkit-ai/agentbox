AGENTBOX_DATABASE_URL=postgresql+asyncpg://agentbox:agentbox@localhost:5434/agentbox
AGENTBOX_S3_ENDPOINT=http://localhost:9010
AGENTBOX_S3_BUCKET=agentbox
AGENTBOX_S3_ACCESS_KEY=agentbox
AGENTBOX_S3_SECRET_KEY=agentbox123
AGENTBOX_MANAGED_DOMAIN=agentbox.local
AGENTBOX_API_BASE_URL=http://localhost:8000
# For inbound webhooks, set the public HTTPS API URL above and the provider's MX hosts below.
# Example for SendGrid: AGENTBOX_MX_HOSTNAMES=mx.sendgrid.net
# See docs/inbound-webhooks.md for Mailgun, SendGrid and Postmark setup.
AGENTBOX_MX_HOSTNAMES=mx1.agentbox.local,mx2.agentbox.local
AGENTBOX_SMTP_BIND_PORT=2525
AGENTBOX_OUTBOUND_SMTP_HOST=localhost
AGENTBOX_OUTBOUND_SMTP_PORT=1025
AGENTBOX_APP_SECRET_KEY=CHANGE-ME-generate-with-agentbox-keygen
AGENTBOX_LOG_LEVEL=INFO
# Browser links: use HTTPS for any non-local host. Never paste mailbox credentials into agent chat.
AGENTBOX_PUBLIC_BASE_URL=http://localhost:8000
# Bring-your-own OAuth apps (available in the open-source core).
# Register the exact redirect URI: ${AGENTBOX_PUBLIC_BASE_URL}/connect/oauth/callback
AGENTBOX_GOOGLE_CLIENT_ID=
AGENTBOX_GOOGLE_CLIENT_SECRET=
AGENTBOX_M365_CLIENT_ID=
AGENTBOX_M365_CLIENT_SECRET=
AGENTBOX_M365_TENANT=common

# Enable dedicated mail only after testing real inbound and outbound delivery.
AGENTBOX_MANAGED_DELIVERY_ENABLED=false
# Advanced self-hosting only; ignored in cloud. Never falls back automatically.
AGENTBOX_ALLOW_APP_PASSWORD_CONNECTIONS=false
