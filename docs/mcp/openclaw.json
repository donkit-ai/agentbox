{
  "mcp": {
    "servers": {
      "agentbox": {
        "command": "uvx",
        "args": ["--from", "agentbox-sdk[mcp] @ git+https://github.com/donkit-ai/agentbox@v0.2.0#subdirectory=sdk/python", "agentbox-mcp"],
        "env": {"AGENTBOX_API_URL": "http://localhost:8000", "AGENTBOX_API_KEY": "REPLACE_WITH_INBOX_SCOPED_KEY"}
      }
    }
  }
}
